{
  "_description": "Schema for the Review Comments Log tables in SubmittalCoverLetter_Template_20260504.docx",
  "_source": "Table indices 2-6 (five pre-built comment blocks). Each block is a 9-row x 5-col table.",
  "table_indices": [2, 3, 4, 5, 6],
