      "cells": {"2": {"label": "(merged response cell)", "fill": "reviewer_comment", "type": "text"}}
    },
    "5": {
      "purpose": "AIC response to reviewer (revision 01)",
      "cells": {"2": {"label": "(merged response cell)", "fill": "aic_response", "type": "text"}}
