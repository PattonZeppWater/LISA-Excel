{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TagDB Direct Data",
  "type": "object",
  "required": ["tagdb_data"],
  "additionalProperties": false,
  "properties": {
    "tagdb_data": {
      "type": "object",
      "required": ["headers", "rows"],
      "additionalProperties": false,
      "properties": {
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "null"] }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "items": {} }
        }
      }
    }
  }
}
