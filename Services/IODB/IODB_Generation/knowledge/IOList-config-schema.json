{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IO List",
  "type": "object",
  "required": ["io_list"],
  "additionalProperties": false,
  "properties": {
    "io_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["proc_ident", "equip_proc_loc", "descriptor", "loop_number", "io_type"],
        "additionalProperties": false,
        "properties": {
          "proc_ident":     { "type": "string", "minLength": 1 },
          "equip_proc_loc": { "type": "string", "minLength": 1 },
          "descriptor":     { "type": "string", "minLength": 1 },
          "loop_number":    { "type": "string", "minLength": 1 },
          "io_type": {
            "type": "string",
            "enum": [
              "DI_Physical", "DO_Physical", "AI_Physical", "AO_Physical",
              "DI_Communicated", "DO_Communicated", "AI_Communicated", "AO_Communicated"
            ]
          },
          "comment":   { "type": ["string", "null"] },
          "range_min": { "type": ["number", "null"] },
          "range_max": { "type": ["number", "null"] },
          "units":     { "type": ["string", "null"] }
        }
      }
    }
  }
}
